.pd-workspace {
    background-color: rgb(24, 28, 34);
    color: rgb(236, 239, 244);
}

.pd-toolbar {
    background-color: rgb(18, 22, 28);
    border-bottom-color: rgba(255, 255, 255, 0.08);
}

.pd-toolbar-title {
    color: rgb(236, 239, 244);
}

.pd-toolbar-button {
    background-color: rgb(34, 40, 49);
    color: rgb(230, 235, 241);
    border-top-color: rgba(255, 255, 255, 0.08);
    border-right-color: rgba(255, 255, 255, 0.08);
    border-bottom-color: rgba(255, 255, 255, 0.08);
    border-left-color: rgba(255, 255, 255, 0.08);
}

.pd-sidebar {
    background-color: rgb(20, 24, 31);
    border-right-color: rgba(255, 255, 255, 0.08);
}

.pd-inspector {
    background-color: rgb(20, 24, 31);
    border-left-color: rgba(255, 255, 255, 0.08);
}

.pd-section-title {
    color: rgb(236, 239, 244);
}

.pd-subsection-title {
    color: rgb(154, 168, 189);
}

.pd-node-library-button,
.pd-filter-button,
.pd-secondary-button {
    background-color: rgb(34, 40, 49);
    color: rgb(230, 235, 241);
    border-top-color: rgba(255, 255, 255, 0.08);
    border-right-color: rgba(255, 255, 255, 0.08);
    border-bottom-color: rgba(255, 255, 255, 0.08);
    border-left-color: rgba(255, 255, 255, 0.08);
}

.pd-canvas {
    background-color: rgb(24, 28, 34);
}

.pd-node {
    background-color: rgb(34, 40, 49);
    border-top-color: rgba(255, 255, 255, 0.08);
    border-left-color: rgba(255, 255, 255, 0.08);
    border-right-color: rgba(255, 255, 255, 0.08);
    border-bottom-color: rgba(255, 255, 255, 0.08);
}

.pd-node-selected {
    border-top-color: rgb(245, 229, 120);
    border-left-color: rgb(245, 229, 120);
    border-right-color: rgb(245, 229, 120);
    border-bottom-color: rgb(245, 229, 120);
}

.pd-node-category {
    color: rgb(154, 168, 189);
}

.pd-node-title {
    color: rgb(236, 239, 244);
}

.pd-node-preview {
    color: rgb(225, 229, 236);
}

.pd-node-signal-chip {
    color: rgb(236, 239, 244);
}

.pd-overview {
    background-color: rgb(18, 22, 28);
    border-top-color: rgba(255, 255, 255, 0.08);
}

.pd-overview-card {
    background-color: rgb(31, 37, 45);
    border-top-color: rgba(255, 255, 255, 0.08);
    border-right-color: rgba(255, 255, 255, 0.08);
    border-bottom-color: rgba(255, 255, 255, 0.08);
    border-left-color: rgba(255, 255, 255, 0.08);
}

.pd-overview-card-active {
    border-top-color: rgb(103, 195, 255);
    border-right-color: rgb(103, 195, 255);
    border-bottom-color: rgb(103, 195, 255);
    border-left-color: rgb(103, 195, 255);
    background-color: rgba(103, 195, 255, 0.12);
}

.pd-overview-value,
.pd-inspector-title,
.pd-welcome-title,
.pd-welcome-preset-title,
.pd-board-browser-title {
    color: rgb(236, 239, 244);
}

.pd-primary-button {
    background-color: rgb(76, 122, 255);
    color: rgb(255, 255, 255);
    border-top-color: rgba(76, 122, 255, 0.9);
    border-right-color: rgba(76, 122, 255, 0.9);
    border-bottom-color: rgba(76, 122, 255, 0.9);
    border-left-color: rgba(76, 122, 255, 0.9);
}

.pd-secondary-button.pd-overview-card-active {
    background-color: rgba(103, 195, 255, 0.16);
    border-top-color: rgb(103, 195, 255);
    border-right-color: rgb(103, 195, 255);
    border-bottom-color: rgb(103, 195, 255);
    border-left-color: rgb(103, 195, 255);
    color: rgb(236, 239, 244);
}

.pd-welcome,
.pd-onboarding-window {
    background-color: rgb(24, 28, 34);
}

.pd-welcome-card,
.pd-onboarding-footer {
    background-color: rgb(28, 34, 42);
}

.pd-welcome-eyebrow {
    color: rgb(103, 195, 255);
}

.pd-welcome-preset,
.pd-foldout {
    background-color: rgb(34, 40, 49);
    border-top-color: rgba(255, 255, 255, 0.08);
    border-right-color: rgba(255, 255, 255, 0.08);
    border-bottom-color: rgba(255, 255, 255, 0.08);
    border-left-color: rgba(255, 255, 255, 0.08);
}

.pd-canvas-hint {
    background-color: rgba(34, 40, 49, 0.96);
    color: rgb(177, 186, 199);
    border-top-color: rgba(255, 255, 255, 0.08);
    border-right-color: rgba(255, 255, 255, 0.08);
    border-bottom-color: rgba(255, 255, 255, 0.08);
    border-left-color: rgba(255, 255, 255, 0.08);
}

.pd-marquee {
    border-top-color: rgba(103, 195, 255, 0.86);
    border-right-color: rgba(103, 195, 255, 0.86);
    border-bottom-color: rgba(103, 195, 255, 0.86);
    border-left-color: rgba(103, 195, 255, 0.86);
    background-color: rgba(103, 195, 255, 0.12);
}

.pd-overview-label,
.pd-welcome-body,
.pd-welcome-preset-description,
.pd-onboarding-meta,
.pd-board-browser-path,
.pd-board-browser-stats,
.pd-board-browser-summary,
.pd-inline-link-menu-body,
.pd-overview-detail {
    color: rgb(177, 186, 199);
}

.pd-foldout .pd-muted-body,
.pd-welcome-card .pd-muted-body,
.pd-onboarding-footer .pd-muted-body,
.pd-board-browser-card .pd-muted-body {
    color: rgb(177, 186, 199);
}

.pd-board-browser-badge {
    color: rgb(210, 226, 255);
    background-color: rgba(103, 195, 255, 0.12);
    border-top-color: rgba(103, 195, 255, 0.2);
    border-right-color: rgba(103, 195, 255, 0.2);
    border-bottom-color: rgba(103, 195, 255, 0.2);
    border-left-color: rgba(103, 195, 255, 0.2);
}

.pd-board-browser-badge-pinned {
    color: rgb(248, 232, 160);
    background-color: rgba(245, 196, 81, 0.18);
    border-top-color: rgba(245, 196, 81, 0.24);
    border-right-color: rgba(245, 196, 81, 0.24);
    border-bottom-color: rgba(245, 196, 81, 0.24);
    border-left-color: rgba(245, 196, 81, 0.24);
}

.pd-board-browser-badge-recent {
    color: rgb(176, 230, 196);
    background-color: rgba(94, 194, 127, 0.18);
    border-top-color: rgba(94, 194, 127, 0.24);
    border-right-color: rgba(94, 194, 127, 0.24);
    border-bottom-color: rgba(94, 194, 127, 0.24);
    border-left-color: rgba(94, 194, 127, 0.24);
}
