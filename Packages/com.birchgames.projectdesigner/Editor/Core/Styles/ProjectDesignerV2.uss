.pd-workspace {
    flex-grow: 1;
    background-color: rgb(240, 245, 252);
    color: rgb(46, 56, 69);
}

.pd-toolbar {
    min-height: 38px;
    padding-left: 12px;
    padding-right: 12px;
    background-color: rgb(248, 250, 255);
    border-bottom-width: 1px;
    border-bottom-color: rgba(69, 102, 171, 0.12);
}

.pd-toolbar-title {
    -unity-font-style: bold;
    margin-right: 10px;
    color: rgb(32, 42, 54);
}

.pd-toolbar-button {
    min-height: 28px;
    width: 96px;
    margin-right: 4px;
    margin-top: 5px;
    margin-bottom: 5px;
    padding-left: 10px;
    padding-right: 10px;
    background-color: rgb(243, 247, 255);
    color: rgb(45, 63, 96);
    border-radius: 10px;
    -unity-font-style: bold;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(76, 122, 255, 0.18);
    border-right-color: rgba(76, 122, 255, 0.18);
    border-bottom-color: rgba(76, 122, 255, 0.18);
    border-left-color: rgba(76, 122, 255, 0.18);
}

.pd-toolbar-menu {
    unity-text-align: middle-center;
}

.pd-toolbar-search,
.pd-toolbar-category {
    min-height: 28px;
    height: 28px;
    max-height: 28px;
    margin-top: 5px;
    margin-bottom: 5px;
}

.pd-workspace-body {
    flex-grow: 1;
    flex-direction: row;
}

.pd-sidebar {
    width: 250px;
    padding: 14px;
    background-color: rgb(246, 249, 255);
    border-right-width: 1px;
    border-right-color: rgba(69, 102, 171, 0.1);
}

.pd-center-column {
    flex-grow: 1;
    flex-direction: column;
    overflow: hidden;
}

.pd-inspector {
    width: 336px;
    padding: 14px;
    background-color: rgb(246, 249, 255);
    border-left-width: 1px;
    border-left-color: rgba(69, 102, 171, 0.1);
}

.pd-section-title {
    margin-top: 4px;
    margin-bottom: 8px;
    -unity-font-style: bold;
    font-size: 15px;
    color: rgb(32, 42, 54);
}

.pd-subsection-title {
    margin-top: 10px;
    margin-bottom: 6px;
    color: rgb(85, 103, 124);
    -unity-font-style: bold;
}

.pd-node-library-button {
    margin-top: 4px;
    margin-bottom: 4px;
    min-height: 32px;
    padding-left: 12px;
    padding-right: 12px;
    background-color: rgb(250, 252, 255);
    color: rgb(45, 63, 96);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(76, 122, 255, 0.15);
    border-right-color: rgba(76, 122, 255, 0.15);
    border-bottom-color: rgba(76, 122, 255, 0.15);
    border-left-color: rgba(76, 122, 255, 0.15);
    border-radius: 10px;
    -unity-font-style: bold;
}

.pd-filter-list {
    flex-direction: column;
}

.pd-filter-button {
    margin-bottom: 4px;
    min-height: 30px;
    padding-left: 10px;
    padding-right: 10px;
    background-color: rgb(250, 252, 255);
    color: rgb(45, 63, 96);
    border-radius: 10px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(76, 122, 255, 0.15);
    border-right-color: rgba(76, 122, 255, 0.15);
    border-bottom-color: rgba(76, 122, 255, 0.15);
    border-left-color: rgba(76, 122, 255, 0.15);
}

.pd-canvas {
    flex-grow: 1;
    background-color: rgb(235, 242, 250);
    overflow: hidden;
}

.pd-marquee {
    position: absolute;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(76, 122, 255, 0.82);
    border-right-color: rgba(76, 122, 255, 0.82);
    border-bottom-color: rgba(76, 122, 255, 0.82);
    border-left-color: rgba(76, 122, 255, 0.82);
    background-color: rgba(76, 122, 255, 0.09);
}

.pd-node {
    padding: 12px;
    padding-right: 64px;
    background-color: rgb(255, 255, 255);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    border-top-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-top-color: rgba(27, 39, 51, 0.08);
    border-left-color: rgba(27, 39, 51, 0.08);
    border-right-color: rgba(27, 39, 51, 0.08);
    border-bottom-color: rgba(27, 39, 51, 0.08);
}

.pd-node-selected {
    border-top-color: rgb(71, 137, 255);
    border-left-color: rgb(71, 137, 255);
    border-right-color: rgb(71, 137, 255);
    border-bottom-color: rgb(71, 137, 255);
}

.pd-node-selection-frame {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: rgb(71, 137, 255);
    border-right-color: rgb(71, 137, 255);
    border-bottom-color: rgb(71, 137, 255);
    border-left-color: rgb(71, 137, 255);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.pd-node-link-frame {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.pd-node-link-valid {
    border-top-color: rgba(77, 184, 115, 0.7);
    border-right-color: rgba(77, 184, 115, 0.7);
    border-bottom-color: rgba(77, 184, 115, 0.7);
    border-left-color: rgba(77, 184, 115, 0.7);
    background-color: rgba(77, 184, 115, 0.04);
}

.pd-node-link-hover {
    border-top-color: rgb(76, 122, 255);
    border-right-color: rgb(76, 122, 255);
    border-bottom-color: rgb(76, 122, 255);
    border-left-color: rgb(76, 122, 255);
    background-color: rgba(76, 122, 255, 0.07);
}

.pd-node-connector {
    position: absolute;
    top: 10px;
    right: 10px;
    min-width: 46px;
    min-height: 24px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 3px;
    padding-bottom: 3px;
    font-size: 10px;
    -unity-font-style: bold;
    text-align: center;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.pd-node-connector-active {
    background-color: rgb(76, 122, 255);
    border-top-color: rgb(76, 122, 255);
    border-right-color: rgb(76, 122, 255);
    border-bottom-color: rgb(76, 122, 255);
    border-left-color: rgb(76, 122, 255);
    color: rgb(255, 255, 255);
}

.pd-node-category {
    color: rgb(103, 119, 136);
    font-size: 11px;
}

.pd-node-category-chip {
    align-self: flex-start;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 3px;
    padding-bottom: 3px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.pd-node-title {
    margin-top: 4px;
    margin-bottom: 6px;
    -unity-font-style: bold;
    font-size: 14px;
    color: rgb(31, 40, 52);
}

.pd-node-signal-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 6px;
}

.pd-node-signal-chip {
    margin-right: 6px;
    margin-bottom: 6px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 3px;
    padding-bottom: 3px;
    font-size: 10px;
    -unity-font-style: bold;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.pd-node-preview {
    flex-grow: 1;
    white-space: normal;
    color: rgb(78, 91, 107);
    margin-bottom: 6px;
}

.pd-node-tag-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 2px;
}

.pd-node-tag-chip {
    margin-right: 6px;
    margin-bottom: 6px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 3px;
    padding-bottom: 3px;
    font-size: 10px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.pd-overview {
    flex-direction: column;
    min-height: 132px;
    padding: 12px;
    background-color: rgb(246, 249, 255);
    border-top-width: 1px;
    border-top-color: rgba(69, 102, 171, 0.1);
}

.pd-overview-row {
    flex-direction: row;
    margin-bottom: 8px;
}

.pd-overview-card {
    width: 120px;
    margin-right: 8px;
    padding: 10px;
    background-color: rgb(255, 255, 255);
    border-radius: 8px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(27, 39, 51, 0.08);
    border-right-color: rgba(27, 39, 51, 0.08);
    border-bottom-color: rgba(27, 39, 51, 0.08);
    border-left-color: rgba(27, 39, 51, 0.08);
}

.pd-overview-workload-card {
    width: 148px;
}

.pd-overview-card-active {
    border-top-color: rgb(76, 122, 255);
    border-right-color: rgb(76, 122, 255);
    border-bottom-color: rgb(76, 122, 255);
    border-left-color: rgb(76, 122, 255);
    background-color: rgba(76, 122, 255, 0.08);
}

.pd-overview-value {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(31, 40, 52);
}

.pd-overview-label {
    color: rgb(103, 119, 136);
}

.pd-overview-detail {
    margin-top: 4px;
    font-size: 10px;
    color: rgb(95, 109, 126);
}

.pd-inspector-title {
    margin-bottom: 10px;
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(32, 42, 54);
}

.pd-edge-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 4px;
    margin-bottom: 4px;
}

.pd-primary-button {
    margin-top: 8px;
    margin-bottom: 4px;
    min-height: 32px;
    padding-left: 12px;
    padding-right: 12px;
    background-color: rgb(91, 127, 245);
    color: rgb(255, 255, 255);
    border-radius: 10px;
    -unity-font-style: bold;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(67, 102, 219, 0.9);
    border-right-color: rgba(67, 102, 219, 0.9);
    border-bottom-color: rgba(67, 102, 219, 0.9);
    border-left-color: rgba(67, 102, 219, 0.9);
}

.pd-secondary-button {
    margin-top: 6px;
    min-height: 30px;
    padding-left: 12px;
    padding-right: 12px;
    background-color: rgb(243, 247, 255);
    color: rgb(45, 63, 96);
    border-radius: 10px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(76, 122, 255, 0.18);
    border-right-color: rgba(76, 122, 255, 0.18);
    border-bottom-color: rgba(76, 122, 255, 0.18);
    border-left-color: rgba(76, 122, 255, 0.18);
}

.pd-secondary-button.pd-overview-card-active {
    background-color: rgba(76, 122, 255, 0.12);
    border-top-color: rgb(76, 122, 255);
    border-right-color: rgb(76, 122, 255);
    border-bottom-color: rgb(76, 122, 255);
    border-left-color: rgb(76, 122, 255);
    color: rgb(32, 58, 105);
}

.pd-welcome {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    background-color: rgb(238, 242, 246);
}

.pd-welcome-card {
    width: 620px;
    padding: 24px;
    background-color: rgb(255, 255, 255);
    border-radius: 12px;
}

.pd-welcome-eyebrow {
    color: rgb(50, 118, 210);
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.pd-welcome-title {
    font-size: 22px;
    -unity-font-style: bold;
    margin-bottom: 10px;
    white-space: normal;
    color: rgb(31, 40, 52);
}

.pd-welcome-body {
    white-space: normal;
    color: rgb(78, 91, 107);
    margin-bottom: 12px;
}

.pd-welcome-preset {
    margin-top: 8px;
    margin-bottom: 8px;
    padding: 12px;
    background-color: rgb(245, 248, 251);
    border-radius: 8px;
}

.pd-welcome-preset-title {
    -unity-font-style: bold;
    color: rgb(31, 40, 52);
}

.pd-welcome-preset-description {
    margin-top: 4px;
    margin-bottom: 8px;
    color: rgb(95, 109, 126);
    white-space: normal;
}

.pd-board-browser-card {
    margin-top: 10px;
    padding: 14px;
    background-color: rgb(245, 248, 251);
    border-radius: 10px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(27, 39, 51, 0.08);
    border-right-color: rgba(27, 39, 51, 0.08);
    border-bottom-color: rgba(27, 39, 51, 0.08);
    border-left-color: rgba(27, 39, 51, 0.08);
}

.pd-board-browser-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.pd-board-browser-title {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(31, 40, 52);
    flex-grow: 1;
    margin-right: 10px;
}

.pd-board-browser-badges {
    flex-direction: row;
    flex-wrap: wrap;
}

.pd-board-browser-badge {
    margin-left: 6px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 3px;
    padding-bottom: 3px;
    font-size: 10px;
    -unity-font-style: bold;
    color: rgb(51, 76, 120);
    background-color: rgba(76, 122, 255, 0.1);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(76, 122, 255, 0.18);
    border-right-color: rgba(76, 122, 255, 0.18);
    border-bottom-color: rgba(76, 122, 255, 0.18);
    border-left-color: rgba(76, 122, 255, 0.18);
    border-radius: 6px;
}

.pd-board-browser-badge-pinned {
    color: rgb(114, 81, 14);
    background-color: rgba(245, 196, 81, 0.16);
    border-top-color: rgba(245, 196, 81, 0.28);
    border-right-color: rgba(245, 196, 81, 0.28);
    border-bottom-color: rgba(245, 196, 81, 0.28);
    border-left-color: rgba(245, 196, 81, 0.28);
}

.pd-board-browser-badge-recent {
    color: rgb(35, 102, 72);
    background-color: rgba(94, 194, 127, 0.14);
    border-top-color: rgba(94, 194, 127, 0.24);
    border-right-color: rgba(94, 194, 127, 0.24);
    border-bottom-color: rgba(94, 194, 127, 0.24);
    border-left-color: rgba(94, 194, 127, 0.24);
}

.pd-board-browser-path {
    margin-top: 4px;
    color: rgb(95, 109, 126);
}

.pd-board-browser-summary {
    margin-top: 8px;
    white-space: normal;
    color: rgb(78, 91, 107);
}

.pd-board-browser-stats {
    margin-top: 8px;
    color: rgb(95, 109, 126);
}

.pd-board-browser-actions {
    flex-direction: row;
    margin-top: 10px;
}

.pd-board-browser-actions > * {
    margin-right: 8px;
}

.pd-browser-toolbar {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 8px;
    margin-bottom: 8px;
}

.pd-browser-search {
    flex-grow: 1;
    min-width: 280px;
    margin-right: 8px;
    min-height: 30px;
}

.pd-browser-sort {
    min-width: 190px;
    margin-right: 8px;
}

.pd-action-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 10px;
}

.pd-action-row > * {
    margin-right: 8px;
    margin-bottom: 8px;
}

.pd-onboarding-window {
    flex-grow: 1;
    background-color: rgb(238, 242, 246);
}

.pd-onboarding-content {
    flex-grow: 1;
    align-items: center;
    padding-top: 20px;
    padding-bottom: 20px;
}

.pd-onboarding-footer {
    width: 620px;
    margin-top: 14px;
    padding: 18px;
    background-color: rgb(255, 255, 255);
    border-radius: 12px;
}

.pd-onboarding-meta {
    color: rgb(95, 109, 126);
    white-space: normal;
    margin-bottom: 6px;
}

.pd-muted-body {
    white-space: normal;
    color: rgb(95, 109, 126);
    margin-bottom: 8px;
}

.pd-foldout {
    margin-bottom: 8px;
    padding: 8px;
    background-color: rgba(255, 255, 255, 0.86);
    border-radius: 8px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(69, 102, 171, 0.1);
    border-right-color: rgba(69, 102, 171, 0.1);
    border-bottom-color: rgba(69, 102, 171, 0.1);
    border-left-color: rgba(69, 102, 171, 0.1);
}

.pd-canvas-hint {
    position: absolute;
    left: 14px;
    top: 14px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 6px;
    padding-bottom: 6px;
    background-color: rgba(247, 250, 255, 0.96);
    color: rgb(65, 82, 110);
    border-radius: 8px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(76, 122, 255, 0.16);
    border-right-color: rgba(76, 122, 255, 0.16);
    border-bottom-color: rgba(76, 122, 255, 0.16);
    border-left-color: rgba(76, 122, 255, 0.16);
}

.pd-inline-link-menu {
    position: absolute;
    width: 260px;
    padding: 14px;
    background-color: rgba(248, 250, 255, 0.99);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(76, 122, 255, 0.18);
    border-right-color: rgba(76, 122, 255, 0.18);
    border-bottom-color: rgba(76, 122, 255, 0.18);
    border-left-color: rgba(76, 122, 255, 0.18);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
}

.pd-inline-link-menu-title {
    -unity-font-style: bold;
    color: rgb(31, 40, 52);
}

.pd-inline-link-menu-body {
    margin-top: 6px;
    margin-bottom: 10px;
    color: rgb(95, 109, 126);
    white-space: normal;
}
