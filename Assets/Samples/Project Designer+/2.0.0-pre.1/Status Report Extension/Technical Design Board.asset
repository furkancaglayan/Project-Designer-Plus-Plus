    - rid: 4671173541606195870
      type: {class: NoteNodeModel, ns: ProjectDesigner.V2.Data, asm: ProjectDesigner.V2.Data}
      data:
        _id: 1912f216e29942428c0e4fcdaa6c9fd0
        _typeId: project-designer.note
        _title: Migration Constraints
        _position: {x: 120, y: 980}
        _size: {x: 300, y: 220}
        _tags:
        - migration
        - decision
        _isPinned: 0
        _body: '- Keep the package UPM-friendly.

          - Avoid dragging legacy
          IMGUI assumptions into the new planner shell.

          - Preserve extension
          points even when the default UX gets simplified.'
        _accentHex: '#4C7AFF'
    - rid: 4671173541606195871
      type: {class: NoteNodeModel, ns: ProjectDesigner.V2.Data, asm: ProjectDesigner.V2.Data}
      data:
        _id: 7b3aaec237624f73a674740da2186d77
        _typeId: project-designer.note
        _title: Technical Risks
        _position: {x: 500, y: 980}
        _size: {x: 300, y: 220}
        _tags:
        - risk
        - architecture
        _isPinned: 0
        _body: '- Drag interactions can regress silently across Unity versions.

          -
          Hidden technical complexity should not leak into the planning-first UX.

          -
          Importer ordering needs tests before more samples ship.'
        _accentHex: '#E58C4A'
